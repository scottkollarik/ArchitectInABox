# =============================================================================
# Technical Architect Platform (AIB) - PRODUCTION Environment Template
# =============================================================================

# Application Identity
APP_NAME="Architect in a Box"
APP_SHORT_NAME=aib
#
# IMPORTANT:
# 1. Copy this to .env.production (which is gitignored)
# 2. Fill in your actual production values
# 3. NEVER commit .env.production to Git
#
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Configuration (set by deployment)
# -----------------------------------------------------------------------------

VITE_API_URL=https://YOUR-BACKEND-URL.azurecontainerapps.io/aib/api
VITE_AUTH_MODE=oauth
VITE_BASE_PATH=/aib
VITE_OAUTH_CLIENT_ID=your-entra-app-id-from-setup-entra-script
VITE_OAUTH_TENANT_ID=your-tenant-id-from-setup-entra-script
VITE_OAUTH_REDIRECT_URI=https://YOUR-FRONTEND-URL.azurecontainerapps.io/aib/auth/callback
VITE_OAUTH_SCOPE=api://your-entra-app-id-from-setup-entra-script/user_impersonation

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production
PathBase=/aib

# Authentication (from Entra ID setup)
EntraAuth__ClientId=your-entra-app-id-from-setup-entra-script
EntraAuth__TenantId=your-tenant-id-from-setup-entra-script
EntraAuth__Instance=https://login.microsoftonline.com/

# -----------------------------------------------------------------------------
# Azure Services (get these from Azure Portal after deployment)
# -----------------------------------------------------------------------------

# Cosmos DB Connection
ConnectionStrings__CosmosDB=AccountEndpoint=https://YOUR-COSMOS-ACCOUNT.documents.azure.com:443/;AccountKey=YOUR-COSMOS-KEY;

# Azure Blob Storage Connection
ConnectionStrings__AzureBlob=DefaultEndpointsProtocol=https;AccountName=YOUR-STORAGE-ACCOUNT;AccountKey=YOUR-STORAGE-KEY;EndpointSuffix=core.windows.net

# Optional: Azure AI Search (if enabled)
# ConnectionStrings__AzureSearch=https://YOUR-SEARCH-SERVICE.search.windows.net;YOUR-ADMIN-KEY

# -----------------------------------------------------------------------------
# Deployment Metadata (for reference)
# -----------------------------------------------------------------------------

AZURE_RESOURCE_GROUP=your-resource-group-name
AZURE_LOCATION=eastus
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_COSMOS_ACCOUNT=your-cosmos-account-name

# -----------------------------------------------------------------------------
# Logging (production settings)
# -----------------------------------------------------------------------------

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
