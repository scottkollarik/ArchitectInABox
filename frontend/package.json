{
  "name": "technical-architect-platform-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:oauth": "../scripts/env-switch.sh oauth-dev && vite",
    "dev:prod-like": "../scripts/env-switch.sh production && vite --mode production",
    "build": "tsc && vite build",
    "build:dev": "../scripts/env-switch.sh development && tsc && vite build --mode development",
    "build:prod": "../scripts/env-switch.sh production && tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "env:local": "../scripts/env-switch.sh local",
    "env:oauth": "../scripts/env-switch.sh oauth-dev",
    "env:prod": "../scripts/env-switch.sh production"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.0.0",
    "@heroicons/react": "^2.0.18",
    "axios": "^1.18.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
