# =============================================================================
# Technical Architect Platform - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Configuration (VITE_* variables are injected at build time)
# -----------------------------------------------------------------------------

# API Endpoint
VITE_API_URL=http://localhost:5001

# Authentication Mode: 'dev' (anonymous) or 'oauth' (Entra ID)
VITE_AUTH_MODE=dev

# OAuth/Entra ID Configuration (required when VITE_AUTH_MODE=oauth)
VITE_OAUTH_CLIENT_ID=your-entra-app-id-here
VITE_OAUTH_TENANT_ID=your-tenant-id-here
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# Base path for hosting under subpath (e.g., /aib)
VITE_BASE_PATH=/

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5001

# Optional: Host under subpath
# PathBase=/aib

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# MongoDB Connection (local development)
ConnectionStrings__MongoDB=mongodb://admin:password123@mongodb:27017/tapdb?authSource=admin

# Alternative Cosmos DB (production)
# ConnectionStrings__CosmosDB=AccountEndpoint=https://your-cosmos.documents.azure.com:443/;AccountKey=your-key;

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------

# Azure Blob Storage (leave empty for in-memory storage in dev)
# ConnectionStrings__AzureBlob=DefaultEndpointsProtocol=https;AccountName=your-storage;AccountKey=your-key;EndpointSuffix=core.windows.net

# Local Azurite (for development)
ConnectionStrings__AzureBlob=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;

# -----------------------------------------------------------------------------
# Authentication Configuration (Backend)
# -----------------------------------------------------------------------------

# Entra ID Configuration (should match frontend values)
EntraAuth__ClientId=your-entra-app-id-here
EntraAuth__TenantId=your-tenant-id-here
EntraAuth__Instance=https://login.microsoftonline.com/

# -----------------------------------------------------------------------------
# Vector/RAG Configuration (Future)
# -----------------------------------------------------------------------------

# Qdrant Vector Database
# ConnectionStrings__Qdrant=http://localhost:6333

# Azure AI Search
# ConnectionStrings__AzureSearch=https://your-search.search.windows.net;your-admin-key

# -----------------------------------------------------------------------------
# Docker Compose Configuration
# -----------------------------------------------------------------------------

# MongoDB Container Settings
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=tapdb

# Development Settings
NODE_ENV=development
COMPOSE_PROJECT_NAME=technical-architect-platform

# -----------------------------------------------------------------------------
# Logging and Debugging
# -----------------------------------------------------------------------------

# Enable debug logging
# Logging__LogLevel__Default=Debug
# Logging__LogLevel__Microsoft=Warning

# -----------------------------------------------------------------------------
# Production Deployment Variables (Set by deployment scripts)
# -----------------------------------------------------------------------------

# Azure Resource Information (populated by deploy.sh)
# AZURE_RESOURCE_GROUP=your-rg
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_COSMOS_ACCOUNT=your-cosmos-account