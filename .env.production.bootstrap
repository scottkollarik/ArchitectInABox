# Bootstrap .env.production - Minimal values needed for initial deployment
# This file gets auto-populated with real values after deployment

# Application Identity (USER DEFINED)
APP_NAME="Architect in a Box"
APP_SHORT_NAME=aib

# Azure Configuration (USER DEFINED)
AZURE_RESOURCE_GROUP=rg_aib_prd
AZURE_LOCATION=eastus

# Global Key Vault (External, for cross-project secrets)
GLOBAL_KEY_VAULT_NAME=kv-technologoo-global
GLOBAL_KEY_VAULT_RG=rg_technologoo_global

# Deployment will auto-populate these:
# ConnectionStrings__CosmosDB=<generated-from-cosmos-deployment>
# ConnectionStrings__AzureBlob=<generated-from-storage-deployment>
# VITE_API_URL=<generated-from-backend-container-app>
# VITE_OAUTH_REDIRECT_URI=<generated-from-frontend-container-app>
# VITE_OAUTH_CLIENT_ID=<generated-from-entra-setup>
# VITE_OAUTH_TENANT_ID=<generated-from-entra-setup>