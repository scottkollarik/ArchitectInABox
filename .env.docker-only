# =============================================================================
# Technical Architect Platform (AIB) - DOCKER-ONLY Environment
# =============================================================================
# This is for development WITHOUT external service integrations
# Safe to commit since it contains no secrets - only local Docker services
# =============================================================================

# Application Identity
APP_NAME=Architect in a Box
APP_SHORT_NAME=aib

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

VITE_API_URL=http://localhost:5001
VITE_AUTH_MODE=dev
VITE_BASE_PATH=/aib
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_TENANT_ID=
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5001

# Authentication (empty = anonymous dev mode)
EntraAuth__ClientId=
EntraAuth__TenantId=
EntraAuth__Instance=https://login.microsoftonline.com/

# -----------------------------------------------------------------------------
# Database Configuration (Local Docker Only)
# -----------------------------------------------------------------------------

# Local Docker MongoDB
ConnectionStrings__MongoDB=mongodb://admin:password123@mongodb:27017/tapdb?authSource=admin

# Local Docker Azurite
ConnectionStrings__AzureBlob=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;

# -----------------------------------------------------------------------------
# AI/LLM Configuration (Disabled for Docker-Only Mode)
# -----------------------------------------------------------------------------

# No external AI services (use mock/disabled implementations)
ENABLE_AI_RECOMMENDATIONS=false
ENABLE_RAG_SEARCH=false
ENABLE_VECTOR_SIMILARITY=false

# Mock AI responses for UI testing
USE_MOCK_AI_RESPONSES=true

# -----------------------------------------------------------------------------
# Docker Compose Settings
# -----------------------------------------------------------------------------

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=tapdb
NODE_ENV=development
COMPOSE_PROJECT_NAME=technical-architect-platform