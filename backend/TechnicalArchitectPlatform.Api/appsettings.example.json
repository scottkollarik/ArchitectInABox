{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Backend": "mongodb",
    "Name": "tapdb"
  },

  "ConnectionStrings": {
    "MongoDB": "mongodb://admin:password123@localhost:27017/technical-architect-db?authSource=admin",
    "CosmosDB": "mongodb://your-cosmosdb-account:your-key@your-account.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@your-account@"
  },

  "EntraAuth": {
    "ClientId": "your-client-id",
    "TenantId": "your-tenant-id"
  },

  "AzureBlob": {
    "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=youraccountkey;EndpointSuffix=core.windows.net"
  },

  "PathBase": ""
}
