# =============================================================================
# Technical Architect Platform (AIB) - SHARED CLOUD DEV Environment Template
# =============================================================================

# Application Identity
APP_NAME=Architect in a Box
APP_SHORT_NAME=aib
#
# This is for TEAM development using shared cloud services
# Each developer gets their own namespace/scope within shared services
#
# SETUP:
# 1. Copy this to .env.shared-cloud-dev (gitignored)
# 2. Replace YOUR-DEV-ID with your identifier (e.g., john, sarah)
# 3. Replace connection strings with actual shared dev services
#
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

VITE_API_URL=http://localhost:5001
VITE_AUTH_MODE=oauth
VITE_BASE_PATH=/

# Shared dev OAuth app (different from production)
VITE_OAUTH_CLIENT_ID=shared-dev-app-id-here
VITE_OAUTH_TENANT_ID=your-tenant-id-here
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5001

# Shared dev OAuth
EntraAuth__ClientId=shared-dev-app-id-here
EntraAuth__TenantId=your-tenant-id-here
EntraAuth__Instance=https://login.microsoftonline.com/

# -----------------------------------------------------------------------------
# Developer Identity (for data partitioning)
# -----------------------------------------------------------------------------

# Your developer identifier (used for data scoping)
DEVELOPER_ID=YOUR-DEV-ID
DEVELOPER_SCOPE=dev

# -----------------------------------------------------------------------------
# Shared Cloud Services
# -----------------------------------------------------------------------------

# Shared development Cosmos DB
# Data is partitioned by developer ID automatically
ConnectionStrings__CosmosDB=AccountEndpoint=https://tap-shared-dev-cosmos.documents.azure.com:443/;AccountKey=SHARED-DEV-KEY;

# Shared development Blob Storage
# Each developer gets their own container: artifacts-YOUR-DEV-ID
ConnectionStrings__AzureBlob=DefaultEndpointsProtocol=https;AccountName=tapshareddevstorage;AccountKey=SHARED-DEV-KEY;EndpointSuffix=core.windows.net

# Optional: Shared development AI Search
# ConnectionStrings__AzureSearch=https://tap-shared-dev-search.search.windows.net;SHARED-DEV-KEY

# -----------------------------------------------------------------------------
# Docker Compose (still needed for local frontend/backend)
# -----------------------------------------------------------------------------

NODE_ENV=development
COMPOSE_PROJECT_NAME=technical-architect-platform-shared-dev

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable shared dev features
ENABLE_DEVELOPER_SCOPING=true
ENABLE_SHARED_DEV_FEATURES=true

# Debug shared services
DEBUG_COSMOS_QUERIES=false
DEBUG_BLOB_OPERATIONS=false